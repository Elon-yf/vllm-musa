From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Wed, 3 Jun 2026 11:47:36 +0000
Subject: [PATCH] MUSA: vllm.utils.deep_gemm

---
 vllm/utils/deep_gemm.py | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/vllm/utils/deep_gemm.py b/vllm/utils/deep_gemm.py
index 6b89f5c33..aca6e9328 100644
--- a/vllm/utils/deep_gemm.py
+++ b/vllm/utils/deep_gemm.py
@@ -65,6 +65,13 @@ class DeepGemmQuantScaleFMT(Enum):
             and is_deep_gemm_supported()
             and (_fp8_gemm_nt_impl is not None)
         )
+        if use_e8m0 and current_platform.is_musa():
+            logger.info_once(
+                "DeepGEMM E8M0 disabled on MUSA: grouped FP8 UE8M0 cast is "
+                "not supported by the MUSA DeepGEMM backend."
+            )
+            use_e8m0 = False
+
         if not use_e8m0:
             cls._oracle_cache = cls.FLOAT32  # type: ignore
             return
@@ -110,6 +117,12 @@ def is_deep_gemm_e8m0_used() -> bool:
         return False
 
     if envs.VLLM_USE_DEEP_GEMM_E8M0:
+        if current_platform.is_musa():
+            logger.info_once(
+                "DeepGEMM E8M0 disabled on MUSA: grouped FP8 UE8M0 cast is "
+                "not supported by the MUSA DeepGEMM backend."
+            )
+            return False
         logger.info_once("DeepGEMM E8M0 enabled on current platform.")
         return True
 
@@ -264,7 +277,7 @@ def get_mk_alignment_for_contiguous_layout() -> list[int]:
     _lazy_init()
     if _get_mk_alignment_for_contiguous_layout_impl is None:
         return _missing()
-    mk_align_size = _get_mk_alignment_for_contiguous_layout_impl()
+    mk_align_size = 128
     return [mk_align_size, mk_align_size]
 
 
