+              max_num_tokens_padded, topk_num, token_mask.data_ptr<int32_t>(),
+              max_loras, lora_ids.data_ptr<int32_t>(),
+              adapter_enabled.data_ptr<int32_t>(), has_expert_map);
         }
       });
