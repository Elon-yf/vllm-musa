diff --git a/vllm/utils/flashinfer.py b/vllm/utils/flashinfer.py
index 4f7d2eecd..34c231a41 100644
--- a/vllm/utils/flashinfer.py
+++ b/vllm/utils/flashinfer.py
@@ -12,6 +12,7 @@ import importlib.util
 import os
 import shutil
 from collections.abc import Callable
+from importlib.metadata import PackageNotFoundError, version
 from typing import Any, NoReturn
 
 import requests
@@ -32,6 +33,9 @@ FLASHINFER_CUBINS_REPOSITORY = os.environ.get(
     "https://edge.urm.nvidia.com/artifactory/sw-kernelinferencelibrary-public-generic-local/",  # noqa: E501
 )
 
+_MUSA_FLASHINFER_DISTRIBUTION = "flashinfer-python"
+_MUSA_FLASHINFER_VERSION = "0.2.6+musa"
+
 
 @functools.cache
 def has_flashinfer_cubin() -> bool:
@@ -47,6 +51,10 @@ def has_flashinfer_cubin() -> bool:
 @functools.cache
 def has_flashinfer() -> bool:
     """Return `True` if flashinfer-python package is available."""
+    # MUSA ships a focused compatibility wrapper. Its individual features are
+    # detected below without enabling the complete CUDA FlashInfer surface.
+    if current_platform.device_type == "musa":
+        return False
     # Use find_spec to check if the module exists without importing it
     # This avoids potential CUDA initialization side effects
     if importlib.util.find_spec("flashinfer") is None:
@@ -87,6 +95,80 @@ def _get_submodule(module_name: str) -> Any | None:
         return None
 
 
+@functools.cache
+def _has_musa_flashinfer_wrapper() -> bool:
+    try:
+        return version(_MUSA_FLASHINFER_DISTRIBUTION) == _MUSA_FLASHINFER_VERSION
+    except PackageNotFoundError:
+        return False
+
+
+@functools.cache
+def _has_flashinfer_feature(module_name: str, attr_name: str) -> bool:
+    if current_platform.device_type == "musa":
+        if not _has_musa_flashinfer_wrapper():
+            return False
+    elif not has_flashinfer():
+        return False
+    try:
+        mod = _get_submodule(module_name)
+    except OSError:
+        if current_platform.device_type == "musa":
+            return False
+        raise
+    return callable(getattr(mod, attr_name, None)) if mod else False
+
+
+def has_flashinfer_bmm_fp8() -> bool:
+    """Return whether the FlashInfer-compatible FP8 BMM API is available."""
+    if current_platform.device_type != "musa":
+        return has_flashinfer()
+    return _has_flashinfer_feature("flashinfer.gemm", "bmm_fp8")
+
+
+def has_flashinfer_sparse_mla() -> bool:
+    """Return whether the FlashInfer-compatible sparse MLA API is available."""
+    return _has_flashinfer_feature(
+        "flashinfer.decode", "trtllm_batch_decode_with_kv_cache_mla"
+    )
+
+
+def _call_flashinfer_bmm_fp8(
+    A: torch.Tensor,
+    B: torch.Tensor,
+    A_scale: torch.Tensor,
+    B_scale: torch.Tensor,
+    dtype: torch.dtype,
+    out: torch.Tensor | None,
+    backend: str,
+) -> torch.Tensor:
+    if current_platform.device_type == "musa":
+        if A_scale.numel() != 1 or B_scale.numel() != 1:
+            raise RuntimeError("MUSA FlashInfer FP8 BMM requires scalar scales")
+        from flashinfer.gemm import bmm_fp8 as bmm_fp8_
+
+        A_scale = A_scale.reshape(())
+        B_scale = B_scale.reshape(())
+    else:
+        from flashinfer import bmm_fp8 as bmm_fp8_
+
+    return bmm_fp8_(A, B, A_scale, B_scale, dtype, out, backend)
+
+
+def _flashinfer_bmm_fp8_fake(
+    A: torch.Tensor,
+    B: torch.Tensor,
+    A_scale: torch.Tensor,
+    B_scale: torch.Tensor,
+    dtype: torch.dtype,
+    backend: str,
+) -> torch.Tensor:
+    del A_scale, B_scale, backend
+    return torch.empty(
+        A.shape[0], A.shape[1], B.shape[2], dtype=dtype, device=A.device
+    )
+
+
 # General lazy import wrapper
 def _lazy_import_wrapper(
     module_name: str, attr_name: str, fallback_fn: Callable[..., Any] = _missing
@@ -674,9 +754,7 @@ if has_flashinfer():
         dtype: torch.dtype,
         backend: str,
     ) -> torch.Tensor:
-        from flashinfer import bmm_fp8 as bmm_fp8_
-
-        return bmm_fp8_(A, B, A_scale, B_scale, dtype, None, backend)
+        return _call_flashinfer_bmm_fp8(A, B, A_scale, B_scale, dtype, None, backend)
 
     @torch.library.register_fake(
         "vllm::bmm_fp8",
@@ -689,9 +767,7 @@ if has_flashinfer():
         dtype: torch.dtype,
         backend: str,
     ) -> torch.Tensor:
-        return torch.empty(
-            A.shape[0], A.shape[1], B.shape[2], dtype=dtype, device=A.device
-        )
+        return _flashinfer_bmm_fp8_fake(A, B, A_scale, B_scale, dtype, backend)
 
     @torch.library.custom_op(
         "vllm::flashinfer_nvfp4_quantize",
@@ -766,6 +842,26 @@ if has_flashinfer():
         return torch.empty(A.shape[0], B.shape[1], dtype=out_dtype, device=A.device)
 
 
+if current_platform.device_type == "musa" and has_flashinfer_bmm_fp8():
+    from vllm.utils.torch_utils import direct_register_custom_op
+
+    def _musa_bmm_fp8(
+        A: torch.Tensor,
+        B: torch.Tensor,
+        A_scale: torch.Tensor,
+        B_scale: torch.Tensor,
+        dtype: torch.dtype,
+        backend: str,
+    ) -> torch.Tensor:
+        return _call_flashinfer_bmm_fp8(A, B, A_scale, B_scale, dtype, None, backend)
+
+    direct_register_custom_op(
+        op_name="bmm_fp8",
+        op_func=_musa_bmm_fp8,
+        fake_impl=_flashinfer_bmm_fp8_fake,
+    )
+
+
