-    assert out.device.type == "cuda"
+    assert out.device.type in ("cuda", "musa")
     assert a.is_contiguous()
 
-    from flashinfer import bmm_fp8 as bmm_fp8_
-
-    bmm_fp8_(
+    _call_flashinfer_bmm_fp8(
         a.unsqueeze(0),
