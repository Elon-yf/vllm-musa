-            return False, "requires CUDA."
+        if not (current_platform.is_cuda() or current_platform.device_type == "musa"):
+            return False, "requires CUDA or MUSA."
 
-        if not has_flashinfer():
+        if not has_flashinfer_bmm_fp8():
             return False, "requires FlashInfer to be installed."
 
