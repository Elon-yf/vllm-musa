+    output = output.view(a.shape[0], b.shape[1])
 
     if bias is not None:
         output = output + bias
@@ -927,15 +1038,11 @@ def flashinfer_scaled_fp8_mm_out(
     assert out.shape == (a.shape[0], b.shape[1])
     assert scale_a.numel() == 1 and scale_b.numel() == 1
