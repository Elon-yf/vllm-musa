+++ b/tests/model_executor/test_ovis_qwen3_5_rope_scope.py
@@ -0,0 +1,73 @@
+from types import SimpleNamespace
+
+import torch
+
+from vllm.model_executor.models.qwen3_5 import _is_ovis_qwen35_config
+from vllm.model_executor.models.ovis_qwen3_5_rope import (
+    OvisVisionApplyRotaryEmb,
+    enable_ovis_vision_rope,
+)
+
+
+def _config():
+    return SimpleNamespace(
+        architectures=["Qwen3_5ForConditionalGeneration"],
+        model_type="qwen3_5",
+        text_config=SimpleNamespace(
+            model_type="qwen3_5_text",
+            hidden_size=1024,
+            intermediate_size=3584,
+            num_hidden_layers=24,
+            num_attention_heads=8,
+            num_key_value_heads=2,
+            head_dim=256,
+            vocab_size=248320,
+        ),
+        vision_config=SimpleNamespace(
+            hidden_size=768,
+            depth=12,
+            num_heads=12,
+            out_hidden_size=1024,
+            patch_size=16,
+            spatial_merge_size=2,
+            temporal_patch_size=2,
+        ),
+    )
+
+
+def test_ovis_guard_accepts_exact_config():
+    assert _is_ovis_qwen35_config(_config(), SimpleNamespace(dtype=torch.bfloat16))
+
+
+def test_ovis_guard_rejects_other_architecture():
+    config = _config()
+    config.architectures = ["Qwen3_5MoeForConditionalGeneration"]
+    assert not _is_ovis_qwen35_config(
+        config, SimpleNamespace(dtype=torch.bfloat16)
+    )
+
+
+def test_ovis_guard_rejects_other_hidden_size():
+    config = _config()
+    config.text_config.hidden_size = 2048
+    assert not _is_ovis_qwen35_config(
+        config, SimpleNamespace(dtype=torch.bfloat16)
+    )
+
+
+def test_ovis_replacement_is_block_local():
+    class ExistingRotary(torch.nn.Module):
+        is_neox_style = True
+        enable_fp32_compute = False
+
+    visual = SimpleNamespace(
+        blocks=[
+            SimpleNamespace(attn=SimpleNamespace(apply_rotary_emb=ExistingRotary()))
+            for _ in range(2)
+        ]
+    )
+    assert enable_ovis_vision_rope(visual) == 2
+    assert all(
+        isinstance(block.attn.apply_rotary_emb, OvisVisionApplyRotaryEmb)
+        for block in visual.blocks
+    )
diff --git a/vllm/model_executor/models/ovis_qwen3_5_rope.py b/vllm/model_executor/models/ovis_qwen3_5_rope.py
new file mode 100644
index 0000000..a6d6499
--- /dev/null
+++ b/vllm/model_executor/models/ovis_qwen3_5_rope.py
@@ -0,0 +1,56 @@
+import torch
+from torch import nn
+
+
+class OvisVisionApplyRotaryEmb(nn.Module):
+    """Model-local adapter to the existing MUSA rotary custom op."""
+
+    def __init__(self, is_neox_style: bool = True, enable_fp32_compute: bool = False):
+        super().__init__()
+        self.is_neox_style = is_neox_style
+        self.enable_fp32_compute = enable_fp32_compute
+
+    def forward(self, x: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor):
+        if x.device.type != "musa":
+            raise RuntimeError("OvisVisionApplyRotaryEmb is MUSA-only")
+        origin_dtype = x.dtype
+        if self.enable_fp32_compute:
+            x = x.float()
+            cos = cos.float()
+            sin = sin.float()
+        batch, seq_len, num_heads, head_size = x.shape
+        query = x.reshape(batch * seq_len, num_heads * head_size)
+        positions = torch.arange(seq_len, device=x.device, dtype=torch.long)
+        positions = positions.repeat(batch)
+        cos_sin_cache = torch.cat((cos, sin), dim=-1).contiguous()
+        from vllm_musa.jit_kernel.csrc.rope import rotary_embedding
+
+        rotary_embedding(
+            positions,
+            query,
+            None,
+            head_size,
+            cos_sin_cache,
+            self.is_neox_style,
+        )
+        return query.view(batch, seq_len, num_heads, head_size).to(origin_dtype)
+
+
+def enable_ovis_vision_rope(visual: nn.Module) -> int:
+    replaced = 0
+    for block in visual.blocks:
+        attention = getattr(block, "attn", None)
+        rotary = getattr(attention, "apply_rotary_emb", None)
+        if rotary is None:
+            continue
+        attention.apply_rotary_emb = OvisVisionApplyRotaryEmb(
+            is_neox_style=rotary.is_neox_style,
+            enable_fp32_compute=rotary.enable_fp32_compute,
+        )
+        replaced += 1
+    if replaced != len(visual.blocks):
+        raise RuntimeError(
+            f"Ovis vision rotary adaptation replaced {replaced}/"
+            f"{len(visual.blocks)} blocks"
+        )
+    return replaced
