From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Elon-yf <309721831+Elon-yf@users.noreply.github.com>
Date: Wed, 30 Sep 2026 11:18:03 +0800
Subject: [PATCH] MUSA: add minimal MinerU Qwen2-VL rotary dispatch

New adapter and test modules are normal vllm-musa source files.
Only the existing upstream Qwen2-VL construction hooks belong here.

---
 vllm/model_executor/models/qwen2_vl.py | 16 +++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/vllm/model_executor/models/qwen2_vl.py b/vllm/model_executor/models/qwen2_vl.py
index 49e026534ca177e95378dbe36578444ec0d118ac..c378f0f35defb60f0b7c15bc0cbf20849f47ac57 100644
--- a/vllm/model_executor/models/qwen2_vl.py
+++ b/vllm/model_executor/models/qwen2_vl.py
@@ -1291,6 +1291,18 @@ class Qwen2VLForConditionalGeneration(
         self.config = config
         self.multimodal_config = multimodal_config
 
+        mineru_qwen2_vl = False
+        if getattr(torch.version, "musa", None) is not None:
+            from vllm_musa.models.mineru_qwen2_vl import (
+                is_mineru_qwen2_vl_config,
+                patch_mineru_rotary,
+                register_mineru_attention_backends,
+            )
+
+            mineru_qwen2_vl = is_mineru_qwen2_vl_config(config)
+            if mineru_qwen2_vl:
+                register_mineru_attention_backends(config)
+
         with self._mark_tower_model(vllm_config, {"image", "video"}):
             self.visual = Qwen2VisionTransformer(
                 config.vision_config,
@@ -1298,6 +1310,8 @@ class Qwen2VLForConditionalGeneration(
                 quant_config=quant_config,
                 prefix=maybe_prefix(prefix, "visual"),
             )
+            if mineru_qwen2_vl:
+                patch_mineru_rotary(self.visual)
             self.input_norm = FusedInputNorm.from_model_config(self.model_config)
 
         with self._mark_language_model(vllm_config):
@@ -1306,6 +1320,8 @@ class Qwen2VLForConditionalGeneration(
                 prefix=maybe_prefix(prefix, "language_model"),
                 architectures=["Qwen2ForCausalLM"],
             )
+            if mineru_qwen2_vl:
+                patch_mineru_rotary(self.language_model)
 
         self.make_empty_intermediate_tensors = (
             self.language_model.make_empty_intermediate_tensors
