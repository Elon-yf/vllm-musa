Subject: [PATCH] MUSA: OvisOCR2 model-local rotary route

Select the existing MUSA rotary path only for the tested Qwen3.5 vision
geometry. The shared adapter is normal vllm-musa source.

Assisted-by: OpenAI Codex

diff --git a/vllm/model_executor/models/qwen3_5.py b/vllm/model_executor/models/qwen3_5.py
index 28c6a11..66ac8d9 100644
--- a/vllm/model_executor/models/qwen3_5.py
+++ b/vllm/model_executor/models/qwen3_5.py
@@ -102,6 +102,62 @@
 logger = init_logger(__name__)
-
+
-
+
+def _enable_musa_ovis_rope(config, model_config, visual) -> None:
+    from vllm.platforms import current_platform
+
+    if not current_platform.is_musa():
+        return
+    if (
+        getattr(config, "model_type", None) != "qwen3_5"
+        or tuple(getattr(config, "architectures", ()) or ())
+        != ("Qwen3_5ForConditionalGeneration",)
+        or str(getattr(model_config, "dtype", None))
+        not in ("bfloat16", "torch.bfloat16")
+    ):
+        return
+    text = getattr(config, "text_config", None)
+    vision = getattr(config, "vision_config", None)
+    if text is None or vision is None:
+        return
+    if (
+        tuple(
+            getattr(text, name, None)
+            for name in (
+                "model_type", "hidden_size", "intermediate_size",
+                "num_hidden_layers", "num_attention_heads",
+                "num_key_value_heads", "head_dim", "vocab_size",
+            )
+        )
+        != ("qwen3_5_text", 1024, 3584, 24, 8, 2, 256, 248320)
+        or tuple(
+            getattr(vision, name, None)
+            for name in (
+                "hidden_size", "depth", "num_heads", "out_hidden_size",
+                "patch_size", "spatial_merge_size", "temporal_patch_size",
+            )
+        )
+        != (768, 12, 12, 1024, 16, 2, 2)
+        or len(visual.blocks) != 12
+    ):
+        return
+    from vllm_musa.model_executor.layers.rotary_embedding.base import (
+        MusaVisionApplyRotaryEmb,
+        MusaVisionRotaryPositions,
+    )
+
+    positions = MusaVisionRotaryPositions()
+    for block in visual.blocks:
+        old = block.attn.apply_rotary_emb
+        block.attn.apply_rotary_emb = MusaVisionApplyRotaryEmb(
+            is_neox_style=old.is_neox_style,
+            enable_fp32_compute=old.enable_fp32_compute,
+            inplace=True,
+            flatten=True,
+            positions_cache=positions,
+            required_bf16_neox_shape=(64, 32),
+        )
+
+
 class Qwen3_5ProcessingInfo(Qwen3VLProcessingInfo):
     def get_hf_config(self):
         return self.ctx.get_hf_config(Qwen3_5Config)
@@ -499,6 +555,7 @@
                 quant_config=quant_config,
                 prefix=maybe_prefix(prefix, "visual"),
             )
+        _enable_musa_ovis_rope(config, self.model_config, self.visual)
-
