From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Wed, 30 Sep 2026 11:18:03 +0800
Subject: [PATCH] MUSA: add minimal MinerU Qwen2-VL rotary dispatch

Keep the upstream Qwen2-VL hook thin; the shared rotary dispatcher selects
the model route from the optimization contract.
---
 vllm/model_executor/models/qwen2_vl.py | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/vllm/model_executor/models/qwen2_vl.py b/vllm/model_executor/models/qwen2_vl.py
index 49e026534c..0ab4bcd6bd 100644
--- a/vllm/model_executor/models/qwen2_vl.py
+++ b/vllm/model_executor/models/qwen2_vl.py
@@ -1307,6 +1307,11 @@ class Qwen2VLForConditionalGeneration(
                 architectures=["Qwen2ForCausalLM"],
             )
 
+        if getattr(torch.version, "musa", None) is not None:
+            from vllm_musa.optimization_contract.rotary import install_model_rotary
+
+            install_model_rotary(self, vllm_config)
+
         self.make_empty_intermediate_tensors = (
             self.language_model.make_empty_intermediate_tensors
         )
