From b7af4923ccae51eac5241c994f6c1a38dd671ce6 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Fri, 30 Oct 2026 09:03:26 +0800
Subject: [PATCH] MUSA: set DeepSeek OCR vision backend priority

---
 vllm/model_executor/models/config.py | 55 ++++++++++++++++++++++++++++
 1 file changed, 55 insertions(+)

diff --git a/vllm/model_executor/models/config.py b/vllm/model_executor/models/config.py
index d294943..77f9022 100644
--- a/vllm/model_executor/models/config.py
+++ b/vllm/model_executor/models/config.py
@@ -40,6 +40,60 @@ class DeepseekV32ForCausalLM(VerifyAndUpdateConfig):
             logger.info("Using bfloat16 kv-cache for DeepSeekV3.2")


+class DeepseekOCRForCausalLMConfig(VerifyAndUpdateConfig):
+    @staticmethod
+    def verify_and_update_config(vllm_config: "VllmConfig") -> None:
+        """Choose the model-local MUSA vision attention priority."""
+        import torch
+        from vllm.platforms import current_platform
+        from vllm.v1.attention.backends.registry import AttentionBackendEnum
+
+        if not current_platform.is_musa():
+            return
+
+        multimodal_config = getattr(
+            vllm_config.model_config, "multimodal_config", None
+        )
+        if multimodal_config is None or multimodal_config.mm_encoder_attn_backend is not None:
+            return
+
+        vision_config = vllm_config.model_config.hf_config.vision_config
+        vision_width = vision_config.width
+        if isinstance(vision_width, dict):
+            vision_width = vision_width.get("clip-l-14-224", next(iter(vision_width.values())))
+        head_size = vision_width["width"] // vision_width["heads"]
+        from vllm_musa.platform import register_attention_backends
+
+        register_attention_backends()
+        device_capability = current_platform.get_device_capability()
+        supported_backends = current_platform.get_supported_vit_attn_backends()
+        fallback = supported_backends[-1]
+        candidates = [AttentionBackendEnum.TRITON_ATTN]
+        candidates.extend(
+            backend
+            for backend in supported_backends[:-1]
+            if backend != AttentionBackendEnum.TRITON_ATTN
+        )
+        for backend in candidates:
+            try:
+                backend_class = backend.get_class()
+                if not backend_class.supports_head_size(head_size):
+                    continue
+                if not backend_class.supports_dtype(torch.float32):
+                    continue
+                if (
+                    device_capability is not None
+                    and not backend_class.supports_compute_capability(device_capability)
+                ):
+                    continue
+            except (ImportError, ValueError, AttributeError):
+                continue
+            multimodal_config.mm_encoder_attn_backend = backend
+            return
+
+        multimodal_config.mm_encoder_attn_backend = fallback
+
+
 class Ernie4_5_VLMoeForConditionalGenerationConfig(VerifyAndUpdateConfig):
     @staticmethod
     def verify_and_update_config(vllm_config: "VllmConfig") -> None:
@@ -904,6 +958,7 @@ class LongcatFlashNgramForCausalLMConfig(VerifyAndUpdateConfig):
 MODELS_CONFIG_MAP: dict[str, type[VerifyAndUpdateConfig]] = {
     "ColBERTJinaRobertaModel": JinaRobertaModelConfig,
     "ColQwen3_5": ColQwen3_5Config,
+    "DeepseekOCRForCausalLM": DeepseekOCRForCausalLMConfig,
     "DeepseekV4ForCausalLM": DeepseekV4ForCausalLMConfig,
     "DeepseekV32ForCausalLM": DeepseekV32ForCausalLM,
     "DiffusionGemmaForBlockDiffusion": DiffusionGemmaModelForBlockDiffusionConfig,  # noqa: E501
